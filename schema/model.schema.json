{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://for63-ai.github.io/AI-Model-Registry/schema/model.schema.json",
  "title": "AI Model Registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "modelName",
    "organisation",
    "modelStatus",
    "aiTask",
    "inputSpecification",
    "outputSpecification",
    "architecture",
    "trainingDataOrigin",
    "primaryPerformanceMetric",
    "license",
    "accessLink",
    "moreInformation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "modelName": {
      "type": "string",
      "minLength": 1
    },
    "organisation": {
      "type": "string",
      "minLength": 1
    },
    "modelStatus": {
      "type": "string",
      "minLength": 1
    },
    "aiTask": {
      "type": "string",
      "minLength": 1
    },
    "inputSpecification": {
      "type": "string",
      "minLength": 1
    },
    "outputSpecification": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "type": "string",
      "minLength": 1
    },
    "trainingDataOrigin": {
      "type": "string",
      "minLength": 1
    },
    "primaryPerformanceMetric": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "accessLink": {
      "type": "string",
      "minLength": 1
    },
    "moreInformation": {
      "type": "string",
      "minLength": 1
    }
  }
}
